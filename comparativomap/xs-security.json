{
  "xsappname": "comparativomap-cvale-prd",
  "tenant-mode": "dedicated",

  "foreign-scope-references": ["uaa.user"],

  "scopes": [
    {
      "name": "$XSAPPNAME.MAP_VIEWER",
      "description": "Acesso ao Mapa Comparativo (Ariba/S4)"
    }
  ],

  "role-templates": [
    {
      "name": "MAP_VIEWER",
      "description": "Usuários autorizados a acessar o Mapa Comparativo",
      "scope-references": ["$XSAPPNAME.MAP_VIEWER"]
    },
    {
      "name": "TOKEN_EXCHANGE",
      "description": "Permite OAuth2UserTokenExchange via Destination",
      "scope-references": ["uaa.user"]
    }
  ],

  "oauth2-configuration": {
    "token-validity": 1800,
    "redirect-uris": [
      "*.cf.br10.hana.ondemand.com",
      "c-vale---ea-cvale00004-prd---hana-cloud-comparativomap-srv.cfapps.br10.hana.ondemand.com",
      "https://*.cfapps.br10.hana.ondemand.com/*",
      "https://*.hana.ondemand.com/**",
      "https://*.applicationstudio.cloud.sap/**"
    ]
  },

  "authorities-inheritance": false
}
