GET http://s4h-qas-cq5:50255/sap/opu/odata/sap/API_INFORECORD_PROCESS_SRV/A_PurgInfoRecdOrgPlantData
Content-Type: application/json
Accept: application/json

# {
#   "VENDOR": "1000034808",
#   "MATERIAL": "84363",
#   "PURCH_ORG": "C001",
#   "PURCHASINGINFOREC": "5300000217"
# }

### LISTA SIMPLES (contexto + TaxCode)
POST http://s4h-qas-cq5:50255/sap/bc/srt/scs/sap/zbapi_po_create1?sap-client=300
Accept: application/json

### FILTRO POR PIR + ORG
GET http://s4h-qas-cq5:50255/sap/opu/odata/sap/API_INFORECORD_PROCESS_SRV/A_PurgInfoRecdOrgPlantData?$format=json&$top=50&$select=PurchasingInfoRecord,PurchasingOrganization,Plant,TaxCode&$filter=PurchasingInfoRecord%20eq%20'5300000000'%20and%20PurchasingOrganization%20eq%20'1000'&sap-client=300
Accept: application/json

### FILTRO POR PIR + ORG + PLANT
GET http://s4h-qas-cq5:50255/sap/opu/odata/sap/API_INFORECORD_PROCESS_SRV/A_PurgInfoRecdOrgPlantData?$format=json&$top=50&$select=PurchasingInfoRecord,PurchasingOrganization,Plant,TaxCode&$filter=PurchasingInfoRecord%20eq%20'5300000000'%20and%20PurchasingOrganization%20eq%20'1000'%20and%20(Plant%20eq%20'1000'%20or%20Plant%20eq%20'1100')&sap-client=300
Accept: application/json

### FILTRO POR MATERIAL (com PIR + ORG para precisão)
GET http://s4h-qas-cq5:50255/sap/opu/odata/sap/API_INFORECORD_PROCESS_SRV/A_PurgInfoRecdOrgPlantData?$format=json&$top=50&$select=PurchasingInfoRecord,PurchasingOrganization,Plant,Material,TaxCode&$filter=Material%20eq%20'000000000000084363'%20and%20PurchasingOrganization%20eq%20'1000'%20and%20PurchasingInfoRecord%20eq%20'5300000000'&sap-client=300
Accept: application/json

### FILTRO POR MATERIAL + SUPPLIER + PIR + ORG
GET http://s4h-qas-cq5:50255/sap/opu/odata/sap/API_INFORECORD_PROCESS_SRV/A_PurgInfoRecdOrgPlantData?$format=json&$top=50&$select=PurchasingInfoRecord,PurchasingOrganization,Plant,Material,Supplier,TaxCode&$filter=Material%20eq%20'000000000000084363'%20and%20Supplier%20eq%20'1000034808'%20and%20PurchasingOrganization%20eq%20'1000'%20and%20PurchasingInfoRecord%20eq%20'5300000000'&sap-client=300
Accept: application/json

### filtro funcionando pelo supplier
GET /sap/opu/odata/sap/API_INFORECORD_PROCESS_SRV/A_PurgInfoRecdOrgPlantData?$format=json&$select=TaxCode,Material,PurchasingInfoRecord,Supplier&$filter=Supplier eq '100067401'&sap-client=300 HTTP/1.1
Host: s4h-qas-cq5:50255
Accept: application/json
Connection: close

### filtro de supplier + material 

GET /sap/opu/odata/sap/API_INFORECORD_PROCESS_SRV/A_PurgInfoRecdOrgPlantData?$format=json&$select=Material,PurchasingInfoRecord,Supplier,TaxCode&$filter=Supplier eq '100581343' and Material eq '558510'&sap-client=300 HTTP/1.1
Host: s4h-qas-cq5:50255
Accept: application/json
Connection: close

### filtrando 2 itens com supplier igual e material diferente
GET /sap/opu/odata/sap/API_INFORECORD_PROCESS_SRV/A_PurgInfoRecdOrgPlantData?$format=json&$select=Material,PurchasingInfoRecord,Supplier,TaxCode&$filter=(Supplier eq '100581343' and Material eq '726133') or (Supplier eq '100581341' and Material eq '726133') or (Supplier eq '100593191' and Material eq '726133')&sap-client=300 HTTP/1.1
Host: s4h-qas-cq5:50255
Accept: application/json
Connection: close

