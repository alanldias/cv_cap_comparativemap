{
  "name": "comparativomap",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^2",
    "@cap-js/sqlite": "^2.0.2",
    "@sap-cloud-sdk/connectivity": "^4.1.1",
    "@sap-cloud-sdk/http-client": "^4.1.1",
    "@sap-cloud-sdk/resilience": "^4.1.1",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "axios": "^1.11.0",
    "dotenv": "^17.2.1",
    "express": "^4",
    "soap": "^1.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.13.0",
    "@sap/cds-dk": ">=8"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-comparativemap": "cds watch --open comparativemap/webapp/index.html?sap-ui-xx-viewCache=false",
    "build": "mbt build -t .",
    "deploy": "cf deploy comparativomap_1.0.0.mtar",
    "undeploy": "cf undeploy comparativomap --delete-services --delete-service-keys --delete-service-brokers"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": "dev.sqlite"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "AribaApproval": {
        "kind": "rest",
        "credentials": {
          "url": "${ARIBA_API_BASE}"
        }
      },
      "BAPI_INFORECORD_GETLIST": {
        "credentials": {
          "destination": "S4H_QAS_CQ5_MAPA",
          "path": "/sap/bc/srt/scs/sap/zbapi_inforecord_getlist?sap-client=300"
        }
      }
    }
  }
}