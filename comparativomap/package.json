{
  "name": "comparativomap",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^2",
    "@cap-js/sqlite": "^2.0.2",
    "@sap-cloud-sdk/connectivity": "^4.1.1",
    "@sap-cloud-sdk/http-client": "^4.1.1",
    "@sap-cloud-sdk/resilience": "^4.1.1",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "axios": "^1.11.0",
    "dotenv": "^17.2.1",
    "express": "^4",
    "soap": "^1.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.13.0",
    "@sap/cds-dk": ">=8",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-comparativemap": "cds watch --open comparativemap/webapp/index.html?sap-ui-xx-viewCache=false",
    "build": "mbt build -t .",
    "deploy": "cf deploy comparativomap_1.0.0.mtar",
    "undeploy": "cf undeploy comparativomap --delete-services --delete-service-keys --delete-service-brokers",
    "format": "prettier --write \"src/**/*.{js,ts,json,md}\"",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts}\" --fix"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": "db.sqlite"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "ARIBA_Event_Management_Prod": {
        "kind": "rest",
        "[production]": {
          "credentials": {
            "destination": "ARIBA_Event_Management_Prod"
          }
        }
      },
      "BAPI_PO_CREATE": {
        "credentials": {
          "destination": "S4H_PRD_CPE_MAPA",
          "path": "/sap/bc/srt/scs/sap/zbapi_po_create1?sap-client=300"
        },
        "API_INFORECORD_PROCESS_SRV": {
          "kind": "odata-v2",
          "model": "srv/external/API_INFORECORD_PROCESS_SRV.csn.json",
          "[production]": {
            "credentials": {
              "destination": "S4H_PRD_CPE_MAPA",
              "path": "/sap/opu/odata/sap/API_INFORECORD_PROCESS_SRV"
            }
          }
        }
      }
    }
  }
}
