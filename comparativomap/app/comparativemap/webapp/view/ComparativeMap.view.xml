<mvc:View controllerName="comparativemap.comparativemap.controller.ComparativeMap"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:mdc="sap.ui.mdc"
    xmlns:mdct="sap.ui.mdc.table">

    <Page id="page" showHeader="true" enableScrolling="false">

        <customHeader>
            <Toolbar id="toolbarCabecalhoTopo" class="cabecalhoTopo">
                <HBox id="hboxCabecalho" width="100%" alignItems="Center" justifyContent="SpaceBetween">
                    <HBox id="hboxEsquerda" width="10%" alignItems="Center" class="fundologo">
                        <Image id="logoTopo"
                            src="https://www.cvale.com.br/site/web-files/imagens/logos/logo.png"
                            height="2rem"
                            width="auto"
                            class="sapUiTinyMarginBegin" />
                    </HBox>
                    <HBox id="hboxCentro" width="80%" justifyContent="Center">
                        <Text id="tituloCabecalho"
                            text="Mapa Comparativo"
                            class="cabecalhoTexto" />
                    </HBox>
                    <HBox id="hboxDireita" width="10%" />
                </HBox>
            </Toolbar>
        </customHeader>

        <content>
            <VBox id="MainContainer" height="100%" renderType="Bare">
                
                <VBox id="searchLayout" class="sapUiSmallMarginTop sapUiSmallMarginBegin" renderType="Bare">
                    <HBox id="searchHBox" alignItems="Center">
                        <Input id="inputDoID" placeholder="Digite o ID da Cotação" width="16rem" class="sapUiTinyMarginBegin" submit=".onBuscar" />
                        <Button id="btnBuscar" text="Buscar" icon="sap-icon://search" type="Emphasized"
                            press=".onBuscar" class="sapUiTinyMarginBegin" />
                    </HBox>
                </VBox>

                <VBox id="tableVBox" fitContainer="false" class="sapUiTinyMargin" renderType="Bare">
                    <layoutData>
                        <FlexItemData id="flexId1" growFactor="1" baseSize="0%"/>
                    </layoutData>

                    <Table id="tblHeader"
                        class="wideTable bordaTabela sapUiTinyMarginTop"
                        inset="false"
                        items="{vm>/headerRows}">
                        <columns>
                            <Column id="colHdrDocId" width="5rem" hAlign="Center"><header><Text id="txtHdrDocId" text="Doc ID"/></header></Column>
                            <Column id="colHdrTipoPedido" width="5rem" hAlign="Center"><header><Text id="txtHdrTipoPedido" text="Tipo Pedido"/></header></Column>
                            <Column id="colHdrOrgCompras" width="5rem" hAlign="Center"><header><Text id="txtHdrOrgCompras" text="Org. Compras"/></header></Column>
                            <Column id="colHdrGrpCompradores" width="5rem" hAlign="Center"><header><Text id="txtHdrGrpCompradores" text="Grp. Compradores"/></header></Column>
                            <Column id="colHdrEmpresa" width="5rem" hAlign="Center"><header><Text id="txtHdrEmpresa" text="Empresa"/></header></Column>
                            <Column id="colHdrIncoterms" width="5rem" hAlign="Center"><header><Text id="txtHdrIncoterms" text="Incoterms"/></header></Column>
                            <Column id="colHdrLocalIncoterms" width="5rem" hAlign="Center"><header><Text id="txtHdrLocalIncoterms" text="Local Incoterms"/></header></Column>
                            <Column id="colHdrCondPagamento" width="5rem" hAlign="Center"><header><Text id="txtHdrCondPagamento" text="Cond. Pagamento"/></header></Column>
                        </columns>
                        <items>
                            <ColumnListItem id="hdrItemTemplate" type="Inactive">
                                <cells>
                                    <Text id="cellHdrDocId" text="{vm>docId}" wrapping="false"/>
                                    <Text id="cellHdrTipoPedido" text="{vm>tipoPedido}" wrapping="false"/>
                                    <Text id="cellHdrOrgCompras" text="{vm>purchasingOrganization}" wrapping="false"/>
                                    <Text id="cellHdrGrpCompradores" text="{vm>purchasingGroup}" wrapping="false"/>
                                    <Text id="cellHdrEmpresa" text="{vm>companyCode}" wrapping="false"/>
                                    <Text id="cellHdrIncoterms" text="{vm>incoterms1}" wrapping="false"/>
                                    <Text id="cellHdrLocalIncoterms" text="{vm>incoterms2}" wrapping="false"/>
                                    <Text id="cellHdrCondPagamento" text="{vm>paymentTerms}" wrapping="false"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                    <mdc:Table id="tblDocs"
                        class="sapUiTinyMarginTop sapUiTinyMarginBottom bordaTabela tabelaTituloAzul"
                        width="100%"
                        selectionMode="Multi"
                        header="Dados Carregados do Ariba"
                        enableExport="true"
                        p13nMode="Column,Sort,Group,Filter"
                        showRowCount="false"
                        threshold="25"
                        delegate='{
                            "name": "comparativemap/comparativemap/delegate/JSONTableDelegate",
                            "payload": {
                                "bindingPath": "vm>/rows"
                            }
                        }'>

                        <mdc:type>
                            <mdct:GridTableType id="gridTableTypeConfig" rowCountMode="Auto" selectionLimit="1000"/>
                        </mdc:type>

                        <mdc:layoutData>
                            <FlexItemData growFactor="1" baseSize="0%" />
                        </mdc:layoutData>
                                
                        <mdc:actions>
                            <Button id="btnSimular" text="Simular Compra" type="Ghost" press=".onSimularPress" />
                        </mdc:actions>

                        <mdc:columns>
                            <mdct:Column id="colFornecedor" propertyKey="supplierName" header="Fornecedor" width="15rem">
                                <Text text="{= ${vm>supplierName} || '-' }" wrapping="true" maxLines="2" tooltip="{vm>supplierName}"/>
                            </mdct:Column>

                            <mdct:Column id="colNomeItem" propertyKey="itemDescription" header="Nome do Item" width="15rem">
                                <Text text="{= ${vm>itemDescription} || '-' }" wrapping="true" maxLines="2" tooltip="{vm>itemDescription}"/>
                            </mdct:Column>

                            <mdct:Column id="colQuantidade" propertyKey="quantity" header="Quantidade" width="7.5rem">
                                <mdct:template>
                                    <StepInput value="{ path: 'vm>quantity', type: 'sap.ui.model.type.Float' }" width="100%" change=".onQtyInlineChange" />
                                </mdct:template>
                            </mdct:Column>

                            <mdct:Column id="colPreco" propertyKey="price" header="Preço do Item" width="8rem" hAlign="End">
                                <Text text="{ path: 'vm>price', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" />
                            </mdct:Column>

                            <mdct:Column id="colMoeda" propertyKey="currency" header="Moeda" width="5rem">
                                <Text text="{= ${vm>currency} || '-' }" />
                            </mdct:Column>

                            <mdct:Column id="colNCM" propertyKey="ncm" header="NCM" width="6rem" hAlign="Center">
                                <Text text="{= ${vm>ncm} || '-' }" />
                            </mdct:Column>

                            <mdct:Column id="colMVA" propertyKey="mva" header="MVA (%)" width="6rem">
                                <Text text="{ path: 'vm>mva', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2 } }" />
                            </mdct:Column>

                            <mdct:Column id="colAliqICMS" propertyKey="Extrinsic_Aliquota_ICMS" header="Alíquota ICMS (%)" width="9rem">
                                <Text text="{ path: 'vm>Extrinsic_Aliquota_ICMS', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2 } }" />
                            </mdct:Column>

                            <mdct:Column id="colICMSAp" propertyKey="Extrinsic_ICMS_Apurado" header="ICMS Apurado" width="8rem">
                                <Text text="{ path: 'vm>Extrinsic_ICMS_Apurado', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2 } }" />
                            </mdct:Column>

                            <mdct:Column id="colAliqIPI" propertyKey="Extrinsic_Aliquota_IPI" header="Alíquota IPI (%)" width="8rem">
                                <Text text="{ path: 'vm>Extrinsic_Aliquota_IPI', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2 } }" />
                            </mdct:Column>

                            <mdct:Column id="colIPIAp" propertyKey="Extrinsic_IPI_Apurado" header="IPI Apurado" width="7rem">
                                <Text text="{ path: 'vm>Extrinsic_IPI_Apurado', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2 } }" />
                            </mdct:Column>

                            <mdct:Column id="colAliqPIS" propertyKey="Extrinsic_Aliquota_PIS" header="Alíquota PIS (%)" width="8rem">
                                <Text text="{ path: 'vm>Extrinsic_Aliquota_PIS', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2 } }" />
                            </mdct:Column>

                            <mdct:Column id="colPISAp" propertyKey="Extrinsic_PIS_Apurado" header="PIS Apurado" width="7rem">
                                <Text text="{ path: 'vm>Extrinsic_PIS_Apurado', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2 } }" />
                            </mdct:Column>

                            <mdct:Column id="colAliqCOFINS" propertyKey="Extrinsic_Aliquota_Cofins" header="Alíq. COFINS (%)" width="9rem">
                                <Text text="{ path: 'vm>Extrinsic_Aliquota_Cofins', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2 } }" />
                            </mdct:Column>

                            <mdct:Column id="colCOFINSAp" propertyKey="Extrinsic_Cofins_apurado" header="COFINS Apurado" width="8rem">
                                <Text text="{ path: 'vm>Extrinsic_Cofins_apurado', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2 } }" />
                            </mdct:Column>

                            <mdct:Column id="colAliqICMSIntra" propertyKey="Extrinsic_Aliquota_ICMS_Interna" header="ICMS Interna (%)" width="9rem">
                                <Text text="{ path: 'vm>Extrinsic_Aliquota_ICMS_Interna', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2 } }" />
                            </mdct:Column>

                            <mdct:Column id="colOrigem" propertyKey="Extrinsic_Origem_do_Material" header="Origem" width="9rem">
                                <Text text="{= ${vm>Extrinsic_Origem_do_Material} || '-' }" />
                            </mdct:Column>

                            <mdct:Column id="colPrecoEstendido" propertyKey="EXTENDEDPRICE" header="Preço Estendido" width="9rem">
                                <Text text="{ path: 'vm>EXTENDEDPRICE', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2 } }" />
                            </mdct:Column>

                            <mdct:Column id="colCentro" propertyKey="PLANT" header="Centro" width="15rem" hAlign="Center">
                                <Text text="{= ${vm>PLANT} || '-' }" tooltip="{vm>PLANT}" />
                            </mdct:Column>

                            <mdct:Column id="colCategoriaItem" propertyKey="ItemCategory" header="Categoria" width="10rem" hAlign="Center">
                                <Text text="{= ${vm>ItemCategory} || '-' }" />
                            </mdct:Column>

                            <mdct:Column id="colReq" propertyKey="CodigoRequisicao" header="Cód. Requisição" width="10rem">
                                <Text text="{= ${vm>CodigoRequisicao} || '-' }" />
                            </mdct:Column>

                            <mdct:Column id="colGrpMateriais" propertyKey="grupo_de_materias" header="Grupo Mat." width="15rem">
                                <Text text="{= ${vm>grupo_de_materias} || '-' }" tooltip="{vm>grupo_de_materias}" />
                            </mdct:Column>

                            <mdct:Column id="colCodMaterial" propertyKey="MaterialCode" header="Cód. Material" width="15rem">
                                <Text text="{= ${vm>MaterialCode} || '-' }" tooltip="{vm>MaterialCode}" />
                            </mdct:Column>

                            <mdct:Column id="colIncoterms" propertyKey="Incoterms" header="Incoterms" width="8rem" hAlign="Center">
                                <Text text="{= ${vm>Incoterms} || '-' }" />
                            </mdct:Column>

                            <mdct:Column id="colNumberItens" propertyKey="NumeroItensRequisicao" header="Nº Itens Req" width="8rem" hAlign="Center">
                                <Text text="{= ${vm>NumeroItensRequisicao} || '-' }" />
                            </mdct:Column>

                            <mdct:Column id="colCodigoRFQ" propertyKey="CodigoRFQ" header="Cód. RFQ" width="8rem">
                                <Text text="{= ${vm>CodigoRFQ} || '-' }" />
                            </mdct:Column>

                            <mdct:Column id="colDeliveryDate" propertyKey="DeliveryDateNice" header="Dt. Entrega Sol." width="8rem">
                                <Text text="{= ${vm>DeliveryDateNice} || '-' }" />
                            </mdct:Column>

                            <mdct:Column id="colPrazoEntrega" propertyKey="PrazoEntrega" header="Prazo" width="8rem" hAlign="Center">
                                <Text text="{= ${vm>PrazoEntrega} || '-' }" />
                            </mdct:Column>
                        </mdc:columns>
                    </mdc:Table>
                </VBox>
            </VBox>
        </content>

        <footer>
            <OverflowToolbar id="pageFooter">
                <ToolbarSpacer id="spacerFooter1"/>
                <Text id="footerTxt" text=""/>
                <ToolbarSpacer id="spacerFooter2"/>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>