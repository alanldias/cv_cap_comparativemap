<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="dlgResultadoPO"
          title="Simulação de Pedido (BAPI_PO_CREATE1)"
          contentWidth="90%"
          contentHeight="70%"
          resizable="true"
          draggable="true">

    <content>
      <VBox class="sapUiSmallMargin" width="100%">
        <!-- Cabeçalho resumido -->
        <ObjectHeader
          title="Fornecedor: {simpo>/header/fornecedor}"
          number="{simpo>/header/poNumber}"
          numberUnit="{= ${simpo>/testRun} ? 'TESTRUN' : '' }">
          <attributes>
            <ObjectAttribute title="Empresa" text="{simpo>/header/empresa}" />
            <ObjectAttribute title="Org. Compras" text="{simpo>/header/orgCompras}" />
            <ObjectAttribute title="Grp. Compras" text="{simpo>/header/grupoCompras}" />
            <ObjectAttribute title="Incoterms" text="{simpo>/header/incoterms1} {simpo>/header/incoterms2}" />
            <ObjectAttribute title="Moeda" text="{simpo>/header/moeda}" />
            <ObjectAttribute title="Criado em" text="{simpo>/header/criadoEm}" />
            <ObjectAttribute title="Criado por" text="{simpo>/header/criadoPor}" />
          </attributes>
        </ObjectHeader>

        <!-- Itens simulados -->
        <Table id="tblResultadoPO" items="{simpo>/itens}" growing="true" growingScrollToLoad="true">
          <columns>
            <Column><Text text="Item"/></Column>
            <Column><Text text="Material"/></Column>
            <Column width="20rem"><Text text="Descrição"/></Column>
            <Column hAlign="End"><Text text="Qtde"/></Column>
            <Column><Text text="Unid."/></Column>
            <Column hAlign="End"><Text text="Preço (NET)"/></Column>
            <Column hAlign="End"><Text text="PriceUnit"/></Column>
            <Column><Text text="TaxCode"/></Column>
            <Column><Text text="TaxJur"/></Column>
            <Column><Text text="NCM"/></Column>
            <Column><Text text="Entrega"/></Column>
            <Column><Text text="Price Date"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{simpo>poItem}"/>
                <Text text="{simpo>material}"/>
                <Text text="{simpo>descricao}"/>
                <ObjectNumber number="{simpo>quantidade}"/>
                <Text text="{simpo>unidade}"/>
                <ObjectNumber number="{path:'simpo>netPrice', formatter: '.fmt2'}"
                              unit="{simpo>/header/moeda}"/>
                <ObjectNumber number="{path:'simpo>priceUnit', formatter: '.fmt2'}"/>
                <Text text="{simpo>taxCode}"/>
                <Text text="{simpo>taxJurCode}"/>
                <Text text="{simpo>ncm}"/>
                <Text text="{path:'simpo>schedules/0/deliveryDate'}"/>
                <Text text="{simpo>priceDate}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>

        <!-- "Rodapé" visual dentro do conteúdo -->
        <Toolbar >
          <ToolbarSpacer/>
          <Button text="Mensagens" type="Emphasized" press=".onShowResultadoMessages"/>
          <Button text="Fechar" press=".onExit"/>
        </Toolbar>
      </VBox>
    </content>

  </Dialog>
</core:FragmentDefinition>
