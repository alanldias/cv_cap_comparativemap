<core:FragmentDefinition 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core"
    xmlns:mdc="sap.ui.mdc"
    xmlns:mdct="sap.ui.mdc.table">

    <Dialog id="dlgRes" title="Resultado da Simulação" titleAlignment="Center" contentWidth="85%" 
         draggable="true" resizable="true">
        
        <content>
            <mdc:Table id="tblRes"
                width="100%"
                selectionMode="Multi"
                class="tabelaTituloAzul"
                enableExport="true"
                header="Dados Retornados da BAPI"
                showRowCount="false"
                p13nMode="Column,Sort,Group,Filter"
                delegate='{
                    "name": "comparativemap/comparativemap/delegate/ResultTableDelegate",
                    "payload": {
                        "bindingPath": "res>/rows"
                    }
                }'
                threshold="100">

                <mdc:type>
                    <mdct:GridTableType rowCountMode="Auto"/>
                </mdc:type>

                <mdc:columns>
                    <mdct:Column id="resColForn" propertyKey="supplierName" header="Fornecedor" width="15rem">
                        <Text text="{= ${res>supplierName} || '-' }" />
                    </mdct:Column>

                    <mdct:Column id="resColMat" propertyKey="materialCode" header="Material" width="10rem">
                        <Text text="{path: 'res>materialCode', formatter: '.formatCleanMaterial'}" tooltip="{res>materialCode}" />
                    </mdct:Column>

                    <mdct:Column id="resColQtdOrig" propertyKey="originalQty" header="Qtd Original" width="7rem" hAlign="Center">
                        <Text text="{path: 'res>originalQty', formatter: '.formatIntegerOrDash'}" />
                    </mdct:Column>

                    <mdct:Column id="resColQtdSim" propertyKey="quantity" header="Qtd Simulada" width="7rem" hAlign="Center">
                        <Text text="{path: 'res>quantity', formatter: '.formatIntegerOrDash'}" />
                    </mdct:Column>

                    <mdct:Column id="resColAward" propertyKey="qtyAward" header="Quantidade p/ Premiar" width="10rem" hAlign="Center">
                        <mdct:template>
                            <StepInput 
                                value="{path:'res>qtyAward', type:'sap.ui.model.type.Integer'}" 
                                width="75%" 
                                textAlign="Center"
                                change=".onAwardQtyChangeRes" 
                                placeholder="-" />
                        </mdct:template>
                    </mdct:Column>

                    <mdct:Column id="resColPreco" propertyKey="price" header="Preço Liquido" width="8rem" hAlign="End">
                        <Text text="{path: 'res>price', formatter: '.formatNumberOrDash'}" />
                    </mdct:Column>

                    <mdct:Column id="resColPrecoBruto" propertyKey="grossPrice" header="Preço Bruto" width="8rem" hAlign="End">
                        <Text text="{ path: 'res>grossPrice', formatter: '.formatNumberOrDash' }" />
                    </mdct:Column>

                    <mdct:Column id="resColMoeda" propertyKey="currency" header="Moeda" width="5rem">
                        <Text text="{= ${res>currency} || '-' }" />
                    </mdct:Column>

                    <mdct:Column id="resColIcms" propertyKey="icms" header="ICMS" width="7rem" hAlign="End">
                        <Text text="{path: 'res>icms', formatter: '.formatNumberOrDash'}" />
                    </mdct:Column>

                    <mdct:Column id="resColIpi" propertyKey="ipi" header="IPI" width="7rem" hAlign="End">
                        <Text text="{path: 'res>ipi', formatter: '.formatNumberOrDash'}" />
                    </mdct:Column>

                    <mdct:Column id="resColTotal" propertyKey="total" header="Total" width="9rem" hAlign="End">
                        <HBox width="100%" justifyContent="End" alignItems="Center">
                            <ObjectNumber 
                                number="{path: 'res>total', formatter: '.formatNumberOrDash'}" 
                                unit="{= ${res>total} ? ${res>currency} : '' }" />
                        </HBox>
                    </mdct:Column>

                    <mdct:Column id="resColNcm" propertyKey="ncm" header="NCM" width="7rem">
                        <Text text="{= ${res>ncm} || '-' }" />
                    </mdct:Column>

                    <mdct:Column id="resColPoItem" propertyKey="poItem" header="Item PO" width="5rem">
                        <Text text="{= ${res>poItem} || '-' }" />
                    </mdct:Column>

                     <mdct:Column id="resColTax" propertyKey="taxCode" header="IVA" width="4rem">
                        <Text text="{= ${res>taxCode} || '-' }" />
                    </mdct:Column>

                </mdc:columns>
            </mdc:Table>
        </content>

        <buttons>
            <Button text="Premiar" type="Emphasized" press=".onAwardDirect"/>
            <Button text="Fechar" press=".onCloseDialog"/>
        </buttons>

    </Dialog>
</core:FragmentDefinition>