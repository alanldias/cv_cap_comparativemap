<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog id="dlgSimulacao" title="Tabela da BAPI" class="dlgWithCustomTitle">
        <customHeader>
            <Bar id="barSimulacaoHeader">
                <contentMiddle>
                    <Text id="txtSimulacaoTitle" text="Tabela da BAPI" class="tituloDialog"/>
                </contentMiddle>
            </Bar>
        </customHeader>
        <VBox id="vboxSimulacaoContainer" class="sapUiSmallMargin" width="100%">
            <Table id="tblSimulacao"
                mode="MultiSelect"
                items="{
                    path: 'sim>/rows'
                }">
                <columns>
                    <Column id="colQuantidade"><Text id="txtColQuantidade" text="Quantidade"/></Column>
                    <Column id="colMoeda"><Text id="txtColMoeda" text="Moeda"/></Column>
                    <Column id="colPreco"><Text id="txtColPreco" text="Preço"/></Column>
                    <Column id="colFornecedorId"><Text id="txtColFornecedorId" text="Fornecedor ID"/></Column>
                    <Column id="colFornecedor"><Text id="txtColFornecedor" text="Fornecedor"/></Column>
                </columns>
                <items>
                    <ColumnListItem id="colunasID">
                        <cells>
                            <Text id="textoColunas1" text="{sim>quantity}"/>
                            <Text id="textoColunas2" text="{sim>currency}"/>
                            <Text id="textoColunas3" text="{sim>netPrice}"/>
                            <Text id="textoColunas4" text="{sim>supplierId}"/>
                            <Text id="textoColunas5" text="{sim>supplierName}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>

        <beginButton>
            <Button id="btnPremiar" text="Premiar" type="Emphasized" press=".onConfirmSimulacao"/>
        </beginButton>
        <endButton>
            <Button id="btnCancelar" text="Cancelar" press=".onCloseSimulacao"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>