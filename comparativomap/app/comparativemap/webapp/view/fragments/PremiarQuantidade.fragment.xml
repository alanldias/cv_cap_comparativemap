<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="dlgAward" title="Premiar Fornecedores" contentWidth="1000px" draggable="true" resizable="true">
    <VBox id="_IDGenVBox" class="sapUiSmallMargin">
      <MessageStrip id="_IDGenMessageStrip" text="A soma das quantidades por ITEM deve ser exatamente igual à quantidade mestre." type="Information" />
      <Table id="_IDGenTable1" items="{qm>/items}" mode="MultiSelect" sticky="ColumnHeaders"
             autoPopinMode="true" growing="true">
        <columns>
          <Column id="_IDGenColumn6" width="12rem"><header><Text id="_IDGenText9" text="Fornecedor"/></header></Column>
          <Column id="_IDGenColumn7" width="10rem"><header><Text id="_IDGenText10" text="Item"/></header></Column>
          <Column id="_IDGenColumn8" width="16rem"><header><Text id="_IDGenText11" text="Descrição"/></header></Column>
          <Column id="_IDGenColumn9" width="7rem"><header><Text id="_IDGenText12" text="Mestre"/></header></Column>
          <Column id="_IDGenColumn10" width="7rem"><header><Text id="_IDGenText13" text="Disponível"/></header></Column>
          <Column id="_IDGenColumn11" width="9rem" hAlign="Center"><header><Text id="_IDGenText14" text="Qtd p/ premiar"/></header></Column>

          <!-- DEBUG: IDs usados na premiação -->
          <Column id="_IDGenColumn12" visible="false" width="8rem"><header><Text id="_IDGenText15" text="ItemId (dbg)"/></header></Column>
          <Column id="_IDGenColumn13" visible="false" width="18rem"><header><Text id="_IDGenText16" text="InvitationId (dbg)"/></header></Column>
        </columns>

        <items>
          <ColumnListItem id="_IDGenColumnListItem1">
            <cells>
              <Text id="_IDGenText17" text="{qm>supplierName}"/>
              <Text id="_IDGenText18" text="{qm>materialCode}"/>
              <Text id="_IDGenText19" text="{qm>description}" maxLines="2" wrapping="true"/>
              <ObjectNumber id="_IDGenObjectNumber2" number="{qm>masterQty}"/>
              <ObjectNumber id="_IDGenObjectNumber3" number="{qm>supplierQty}"/>
              <Input id="_IDGenInput1" type="Number"
                     value="{path:'qm>qtyAward', type: 'sap.ui.model.type.Integer'}"
                     liveChange=".onAwardQtyChange"
                     width="7rem"/>

              <!-- DEBUG cells -->
              <Text  id="_IDGenText20" text="{qm>itemId}"/>
              <Text id="_IDGenText21" text="{qm>invitationId}"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>

      <!-- Resumo por itemKey -->
      <Toolbar id="_IDGenToolbar" class="sapUiSmallMarginTop">
        <Text id="_IDGenText22" text="Restante por item:"/>
        <ToolbarSpacer id="_IDGenToolbarSpacer1"/>
        <Text id="_IDGenText23" text="{qm>_summaryText}" />
      </Toolbar>
    </VBox>

    <beginButton>
      <Button id="_IDGenButton" text="Premiar" type="Emphasized" enabled="{qm>/validAward}" press=".onConfirmAward"/>
    </beginButton>
    <endButton>
      <Button id="_IDGenButton3" text="Cancelar" press=".onCloseDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
