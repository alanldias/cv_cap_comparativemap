<!-- webapp/view/fragments/FracionarSimulacao.fragment.xml -->
<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="dlgSim"
          title="Quantidades para SIMULAÇÃO"
          contentWidth="900px"
          draggable="true" resizable="true">
    <Table id="_IDGenTable3" items="{qm>/items}" sticky="ColumnHeaders" mode="None"
           autoPopinMode="true" growing="true">
      <columns>
        <Column id="_IDGenColumn23" width="12rem"><header><Text id="_IDGenText37" text="Fornecedor"/></header></Column>
        <Column id="_IDGenColumn24" width="10rem"><header><Text id="_IDGenText38" text="Item"/></header></Column>
        <Column id="_IDGenColumn25" width="16rem"><header><Text id="_IDGenText39" text="Descrição"/></header></Column>
        <Column id="_IDGenColumn26" width="7rem"><header><Text id="_IDGenText40" text="Mestre"/></header></Column>
        <Column id="_IDGenColumn27" width="7rem"><header><Text id="_IDGenText41" text="Disponível"/></header></Column>
        <Column id="_IDGenColumn28" width="10rem" hAlign="Center"><header><Text id="_IDGenText42" text="Qtd p/ simular"/></header></Column>
      </columns>
      <items>
        <ColumnListItem id="_IDGenColumnListItem3">
          <cells>
            <Text id="_IDGenText43" text="{qm>supplierName}"/>
            <Text id="_IDGenText44" text="{qm>materialCode}"/>
            <Text id="_IDGenText45" text="{qm>description}" wrapping="true" maxLines="2"/>
            <ObjectNumber id="_IDGenObjectNumber9" number="{qm>masterQty}"/>
            <ObjectNumber id="_IDGenObjectNumber10" number="{qm>supplierQty}"/>
            <Input id="_IDGenInput2" type="Number"
                   value="{path:'qm>qtySim', type:'sap.ui.model.type.Integer'}"
                   liveChange=".onSimQtyChange"
                   width="7rem"/>
          </cells>
        </ColumnListItem>
      </items>
    </Table>

    <beginButton>
      <Button id="_IDGenButton7" text="Simular" type="Emphasized" press=".onConfirmSimulate"/>
    </beginButton>
    <endButton>
      <Button id="_IDGenButton8" text="Cancelar" press=".onCloseDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
